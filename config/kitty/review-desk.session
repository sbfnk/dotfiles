# Opened at startup on the machines you review from (see bin/review-desk):
# gh-dash, the bot's activity and the board of work waiting for a decision as
# the first three tabs, then a shell, which has the focus.
new_tab prs
launch --title prs sh -c 'exec "$HOME/.local/bin/review-desk" run prs'

new_tab bot
launch --title bot sh -c 'exec "$HOME/.local/bin/review-desk" run bot'

new_tab board
launch --title board sh -c 'exec "$HOME/.local/bin/review-desk" run board'

new_tab
launch
focus
