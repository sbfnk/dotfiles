#!/usr/bin/env bash
# Mint a short-lived installation token for the sbfnk-review-bot GitHub App,
# so PR review findings post as sbfnk-review-bot[bot] instead of sbfnk-bot.
#
# The app ID is public (visible in the app's URL); the only secret is the
# private key, which lives outside the repo in ~/.config/sbfnk-review-bot/.
# Tokens are scoped to pull-request read/write on the given repo and expire
# after an hour.
#
# Usage:
#   GITHUB_TOKEN=$(gh-review-bot-token <owner>/<repo>) gh api ...
#
# Exits 2 if the app is not installed on the repo. Callers then post no review
# comments under either account and keep the findings local (see the
# review-loop skill). Any other failure exits 1.
set -euo pipefail

app_id=4359973
key=$HOME/.config/sbfnk-review-bot/key.pem

show_permissions=false
if [[ ${1-} == --permissions ]]; then
  show_permissions=true
  shift
fi

if [[ $# -ne 1 || $1 != */* ]]; then
  echo "usage: $(basename "$0") [--permissions] <owner>/<repo>" >&2
  exit 64
fi
repo=$1

if [[ ! -r $key ]]; then
  echo "private key not found at $key" >&2
  exit 1
fi

b64url() { openssl base64 -A | tr '+/' '-_' | tr -d '='; }

now=$(date +%s)
header=$(printf '{"alg":"RS256","typ":"JWT"}' | b64url)
payload=$(printf '{"iat":%d,"exp":%d,"iss":%d}' \
  "$((now - 60))" "$((now + 540))" "$app_id" | b64url)
signature=$(printf '%s.%s' "$header" "$payload" |
  openssl dgst -sha256 -sign "$key" -binary | b64url)
jwt="$header.$payload.$signature"

lookup=$(curl -s -w '\n%{http_code}' \
  -H "Authorization: Bearer $jwt" \
  -H "Accept: application/vnd.github+json" \
  "https://api.github.com/repos/$repo/installation") || {
  echo "could not reach GitHub to look up the installation on $repo" >&2
  exit 1
}
status=${lookup##*$'\n'}
# Only a 404 means the app is not installed. Any other failure (a 5xx, or a JWT
# rejected for clock skew) must not send callers down the no-app path.
if [[ $status == 404 ]]; then
  echo "sbfnk-review-bot is not installed on $repo" >&2
  exit 2
elif [[ $status != 200 ]]; then
  echo "installation lookup on $repo failed with HTTP $status" >&2
  exit 1
fi
installation_id=$(jq -r .id <<<"${lookup%$'\n'*}")

# The same wording as the lookup above, so callers can tell a network failure
# or a 5xx, which may clear, from a failure that waiting will not fix.
minted=$(curl -s -w '\n%{http_code}' -X POST \
  -H "Authorization: Bearer $jwt" \
  -H "Accept: application/vnd.github+json" \
  "https://api.github.com/app/installations/$installation_id/access_tokens") || {
  echo "could not reach GitHub to mint an installation token for $repo" >&2
  exit 1
}
status=${minted##*$'\n'}
if [[ $status != 201 ]]; then
  echo "minting an installation token for $repo failed with HTTP $status" >&2
  exit 1
fi
response=${minted%$'\n'*}

# --permissions reports what the installation actually grants, which is the only
# way to tell a missing scope from an endpoint the app simply may not call.
if [[ $show_permissions == true ]]; then
  jq -r '.permissions' <<<"$response"
else
  jq -r .token <<<"$response"
fi
